{
  "expo": {
    "name": "cwgapp",
    "slug": "cwgapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img_app_icon.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/img_app_icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#181615"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cwgapp.store"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img_app_icon.jpg",
        "backgroundColor": "#181615"
      },
      "package": "com.cwgapp.store"
    },
    "web": {
      "favicon": "./assets/img_app_icon.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ]
  }
}
