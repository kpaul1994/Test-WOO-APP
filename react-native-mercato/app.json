{
  "expo": {
    "name": "NextEcom",
    "slug": "nextecom",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/img_app_icon.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/img_app_icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#181615"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nextecom.store"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img_app_icon.jpg",
        "backgroundColor": "#181615"
      },
      "package": "com.nextecom.store",
      "versionCode": 2
    },
    "web": {
      "name": "NextEcom",
      "shortName": "NextEcom",
      "favicon": "./assets/img_app_icon.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ]
  }
}
